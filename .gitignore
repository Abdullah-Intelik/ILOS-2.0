# Ignore all .env files everywhere
.env
**/.env

.next
**/.next

# Ignore all node_modules folders everywhere
node_modules/
**/node_modules/

# OS / IDE clutter
.DS_Store
.vscode/
.idea/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Build output
dist/
build/

# Optional: coverage reports
coverage/

# Optional: database files (if any local SQLite testing)
*.sqlite
*.db

# Optional: local backups or dump files
*.sql
*.dump

# Office temporary lock files (avoid commit failures on Windows)
**/~$*.xls*
**/~$*.docx
**/~$*.pptx

# Specific path where Excel files are stored
excel_files/store/~$*.xls*
