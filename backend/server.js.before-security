// =============================================================================
// SECURITY CONFIGURATION VALIDATION
// =============================================================================

try {
    securityConfig.validate();
    console.log('✅ Security configuration validated');
} catch (error) {
    console.error('❌ Security configuration error:', error.message);
    process.exit(1);
