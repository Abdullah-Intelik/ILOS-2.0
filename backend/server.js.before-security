// =============================================================================
// DATABASE CHANGE DETECTION (Admin only)
// =============================================================================

console.log('🔍 Initializing Database Change Detection...');
try {
    const DatabaseChangeProcessor = require('./lib/DatabaseChangeProcessor');
    const dbChangeProcessor = new DatabaseChangeProcessor();
    
    // Start processing database changes
    dbChangeProcessor.startProcessing();
    console.log('✅ Database change detection started');

    // Database changes API (admin only)
    app.get('/api/database-changes/health', 
        authenticate,
        requireAdmin,
        async (req, res) => {
            try {
                const stats = await dbChangeProcessor.getProcessingStats();
                res.json({
                    health: {
                        status: 'healthy',
                        processor: 'active'
                    },
                    stats: stats
                });
            } catch (error) {
                res.status(500).json({
                    health: {
                        status: 'error',
                        error: error.message
                    }
                });
            }
        }
    );

    app.get('/api/database-changes/recent', 
        authenticate,
        requireAdmin,
        async (req, res) => {
            try {
                const changes = await dbChangeProcessor.getRecentChanges(50);
                res.json({
                    success: true,
                    changes: changes
                });
            } catch (error) {
                res.status(500).json({
                    success: false,
                    error: error.message
                });
            }
        }
    );

    // Graceful shutdown handler
    process.on('SIGTERM', () => {
        console.log('🛑 Stopping database change processor...');
        dbChangeProcessor.stopProcessing();
    });

} catch (error) {
    console.error('❌ Database change detection setup failed:', error.message);
}

