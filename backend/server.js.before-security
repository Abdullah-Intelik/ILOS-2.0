// =============================================================================
// SECURITY MIDDLEWARE (Applied in order - CRITICAL!)
// =============================================================================

// 1. Trust proxy (for rate limiting and IP detection)
app.set('trust proxy', process.env.TRUSTED_PROXIES?.split(',') || ['127.0.0.1']);

// 2. Security headers (MUST be first)
app.use(helmet({
    contentSecurityPolicy: securityConfig.headers.contentSecurityPolicy,
    hsts: securityConfig.headers.hsts,
    referrerPolicy: securityConfig.headers.referrerPolicy,
    crossOriginEmbedderPolicy: false, // Banking apps may need iframe embedding
    crossOriginResourcePolicy: { policy: "cross-origin" }
}));

// 3. CORS configuration
app.use(cors(securityConfig.cors));

// 4. Request compression
app.use(compression());

// 5. Request parsing with size limits
app.use(express.json({ 
    limit: '10mb',
    verify: (req, res, buf) => {
        // Store raw body for webhook signature verification if needed
        req.rawBody = buf;
    }
}));
app.use(express.urlencoded({ 
    limit: '10mb', 
    extended: true,
    parameterLimit: 100 // Prevent parameter pollution
}));

// 6. Input sanitization and SQL injection protection
app.use(sanitizeInput);
app.use(sqlInjectionProtection);

// 7. Global rate limiting
app.use(apiLimiter);

